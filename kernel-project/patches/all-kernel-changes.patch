### drivers/memory/mtk-smi.c
--- a/drivers/memory/mtk-smi.c
+++ b/drivers/memory/mtk-smi.c
@@ -484,6 +484,28 @@
 	return 0;
 }
 
+/*
+ * MAIC diag: cmdline-gated escape for the DISP power-domain teardown.
+ *
+ * mtk_smi_init_late() drops the last reference on the DISP power domain at late_initcall,
+ * which runs scpsys_power_off(): bus protection, SRAM power-down,
+ * clk_disable_unprepare(smi_mm), ISO assert, RST_B hardware reset, PWR_ON cleared. On a
+ * normal Android boot SurfaceFlinger immediately re-opens fb0 and the path is powered back
+ * up, so nobody notices. Booting the recovery slot, nothing ever performs that repair, so a
+ * display inherited from LK dies here -- which is the leading explanation for our green
+ * screen. There is no generic cmdline escape for this path (pd_ignore_unused only guards
+ * genpd_poweroff_unused, not an explicit put_sync), hence this flag.
+ *
+ * Default is OFF, i.e. behaviour identical to stock. Pass "smi_keep_disp" to skip the put.
+ */
+static bool smi_keep_disp __initdata;
+static int __init smi_keep_disp_setup(char *__unused)
+{
+	smi_keep_disp = true;
+	return 1;
+}
+__setup("smi_keep_disp", smi_keep_disp_setup);
+
 /* put the disp power domain that we got in smi probe */
 static int __init mtk_smi_init_late(void)
 {
@@ -502,7 +524,12 @@
 	 * for the disp power domain.
 	 */
 	dev = common->dev;
-	pm_runtime_put_sync(dev);
+	if (smi_keep_disp) {
+		pr_err("MAIC smi: keeping DISP power domain (smi_keep_disp)\n");
+	} else {
+		pr_err("MAIC smi: dropping DISP power domain ref now\n");
+		pm_runtime_put_sync(dev);
+	}
 
 	return smi_dev_register();
 }
