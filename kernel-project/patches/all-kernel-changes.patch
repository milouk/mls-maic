### drivers/soc/mediatek/mtk-scpsys-mt8167.c
--- a/drivers/soc/mediatek/mtk-scpsys-mt8167.c
+++ b/drivers/soc/mediatek/mtk-scpsys-mt8167.c
@@ -131,6 +131,39 @@
 	return -EINVAL;
 }
 
+/*
+ * MAIC diag: the markers above fire at ~0.5-1.7s, but the persistent console is a 64K ring
+ * that must stay byte-compatible with stock's pstore layout, so on a long or chatty boot the
+ * early lines wrap away before anyone can read them. Re-print the same facts as a compact
+ * summary from a late delayed work, which lands in the TAIL of the ring and therefore
+ * survives. Also prints once more at +25s, past the 31s watchdog's usual firing point, so a
+ * hang still leaves a readable record.
+ */
+int maic_pd_on, maic_pd_off, maic_disp_on, maic_disp_off;
+static int maic_summary_runs;
+EXPORT_SYMBOL(maic_disp_off);
+static struct delayed_work maic_summary_work;
+static void maic_summary_fn(struct work_struct *w)
+{
+	pr_err("MAIC SUMMARY: pd_on=%d pd_off=%d disp_on=%d disp_off=%d\n",
+	       maic_pd_on, maic_pd_off, maic_disp_on, maic_disp_off);
+	if (maic_disp_off)
+		pr_err("MAIC SUMMARY: DISP POWER DOMAIN WAS TURNED OFF -- display teardown happened\n");
+	else
+		pr_err("MAIC SUMMARY: disp domain still powered -- teardown did NOT happen\n");
+	/* Re-arm once. The device has hung ~5s into recovery, so a single late snapshot
+	 * would never run; fire early for the hang case and again later if we survive. */
+	if (++maic_summary_runs < 3)
+		schedule_delayed_work(&maic_summary_work, msecs_to_jiffies(12000));
+}
+static int __init maic_summary_init(void)
+{
+	INIT_DELAYED_WORK(&maic_summary_work, maic_summary_fn);
+	schedule_delayed_work(&maic_summary_work, msecs_to_jiffies(3000));
+	return 0;
+}
+late_initcall(maic_summary_init);
