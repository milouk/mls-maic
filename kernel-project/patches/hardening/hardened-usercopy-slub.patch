+#ifdef CONFIG_HARDENED_USERCOPY
+/*
+ * MAIC: SLUB hardened-usercopy heap object check (backported from upstream 4.8,
+ * commit ed18adc1cdd0). The vendor tree backported __check_heap_object() for SLAB
+ * only; this tree uses SLUB, so the symbol was undefined at link once
+ * CONFIG_HARDENED_USERCOPY was enabled. Rejects copies to/from userspace that do
+ * not fall entirely within a single slab object. No red_left_pad handling: that
+ * kmem_cache field does not exist on this 4.4 SLUB.
+ */
+const char *__check_heap_object(const void *ptr, unsigned long n,
+				struct page *page)
+{
+	struct kmem_cache *s;
+	unsigned long offset;
+
+	/* Find object. */
+	s = page->slab_cache;
+
+	/* Reject impossible pointers. */
+	if (ptr < page_address(page))
+		return s->name;
+
+	/* Find offset within object. */
+	offset = (ptr - page_address(page)) % s->size;
+
+	/* Allow address range falling entirely within object size. */
+	if (offset <= s->object_size && n <= s->object_size - offset)
+		return NULL;
+
+	return s->name;
+}
+#endif /* CONFIG_HARDENED_USERCOPY */
