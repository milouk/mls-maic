#!/system/bin/sh
# MAIC performance tuning (device is always on AC). Magisk late_start service.
# REPLACEMENT for /data/adb/service.d/perf.sh -- prepared 2026-09-15, NOT installed.
#
# Changes vs the current perf.sh (everything else is kept verbatim):
#  1. CPU governor: interactive with tuned tunables instead of `performance`.
#     `performance` pins 1300 MHz 24/7 (time_in_state: 92126 of 92690 ticks at 1300000) and ran
#     the SoC at ~55-63 C; it would also pin any overclock OPP permanently. interactive still
#     jumps to hispeed on load, so a TV/streaming UI stays responsive.
#  2. MTK hotplug (HPS) stays OFF as before (KEEP_HPS_OFF=1). Thermal throttling on this SoC
#     used to depend on HPS: the vendor mt_cpufreq_thermal_protect() resolved its power budget
#     to "fewer cores at a high frequency" (300 mW -> 1 core @ 1400 MHz, measured 2026-09-17) and
#     with HPS off that is a no-op -- the SoC ran to 90.7 C with the thermostat "active". rm4
#     kernels lower the FREQUENCY instead (core-count match restored, clip overrides the floor),
#     so HPS is optional again; set KEEP_HPS_OFF=0 to add core hotplug as a second lever.
#  3. Removed `echo 390000 > /proc/gpufreq/gpufreq_opp_freq`: 390000 is not an OPP on this unit
#     (table is 403000/299000/253500) and the knob stayed "keep opp frequency disabled".
#  4. CPU range is explicit. OC_MIN_KHZ=598000 = the lowest OPP: the user's final word (2026-09-17)
#     is "interactive on the full freq range" -- idle drops to 598 MHz, a busy sample jumps to
#     hispeed (1300 MHz, today's fixed speed), 1400/1500 need ~90 % load. Thermal may clip below
#     whatever floor is set (rm4), which also covers PerfService's transient boost floors.
#     OC_MAX_KHZ (default 1300000 = stock) is raised to 1500000 ONLY after the ceiling-mode soak
#     passed on the rm4 kernel (frequency seen dropping at the 80.4 C trip).
OC_MIN_KHZ=598000
OC_MAX_KHZ=1300000
KEEP_HPS_OFF=1

while [ "$(getprop sys.boot_completed)" != "1" ]; do sleep 2; done
sleep 6

C=/sys/devices/system/cpu
# CPU: interactive governor. Global tunables (4.4 android interactive) or per-policy.
for g in $C/cpu[0-9]*/cpufreq/scaling_governor; do echo interactive > "$g" 2>/dev/null; done
for T in $C/cpufreq/interactive $C/cpu0/cpufreq/interactive; do
	[ -d "$T" ] || continue
	echo 20000   > $T/timer_rate 2>/dev/null           # sample every 20 ms
	echo 1300000 > $T/hispeed_freq 2>/dev/null         # first jump on a busy sample = today's fixed 1300
	echo 85      > $T/go_hispeed_load 2>/dev/null
	echo 40000   > $T/above_hispeed_delay 2>/dev/null   # hold 40 ms before going above hispeed
	echo "80 1300000:90" > $T/target_loads 2>/dev/null  # above 1300 MHz needs ~90% load
	echo 60000   > $T/min_sample_time 2>/dev/null
	echo 0       > $T/io_is_busy 2>/dev/null
done
# CPU range (policy is shared by all 4 cores)
# rm3+ kernels enforce a hard ceiling in ->verify() (maic_oc_ceiling_khz, default 1300000) that
# PerfService/thermal cannot lift; set it to the chosen ceiling first, then the policy max, then
# the floor (PerfService rewrites scaling_min_freq during boosts; it settles back on its own).
#
# Boot guard for the persistent OC ceiling: the kernel boots at 1300 MHz regardless; the raise
# happens here, at late_start. A marker is armed just before raising and cleared once the boot
# has stayed up 10 minutes. A marker still present at boot means the previous boot did not
# survive that window (hang, watchdog) -> stay at 1300 MHz and log it; the OC then needs a
# deliberate `rm` of the marker to re-enable.
KNOB=$(ls /sys/module/*/parameters/maic_oc_ceiling_khz 2>/dev/null | head -1)
GUARD=/data/adb/maic-oc-armed
LOG=/data/adb/maic-oc.log
if [ "$OC_MAX_KHZ" -gt 1300000 ] && [ -f "$GUARD" ]; then
	echo "$(date) previous boot did not clear $GUARD -> OC ceiling NOT raised, staying 1300000" >> $LOG
	OC_MAX_KHZ=1300000
fi
if [ "$OC_MAX_KHZ" -gt 1300000 ]; then
	echo "$(date) armed" > $GUARD; sync
	( sleep 600; rm -f $GUARD; echo "$(date) boot stable 10 min with ceiling $OC_MAX_KHZ, guard cleared" >> $LOG ) &
fi
[ -n "$KNOB" ] && echo $OC_MAX_KHZ > $KNOB 2>/dev/null
echo $OC_MAX_KHZ > $C/cpu0/cpufreq/scaling_max_freq 2>/dev/null
[ "$OC_MIN_KHZ" -gt "$OC_MAX_KHZ" ] && OC_MIN_KHZ=$OC_MAX_KHZ
echo $OC_MIN_KHZ > $C/cpu0/cpufreq/scaling_min_freq 2>/dev/null
echo "$(date) ceiling=$OC_MAX_KHZ floor=$OC_MIN_KHZ knob=$(cat $KNOB 2>/dev/null) min=$(cat $C/cpu0/cpufreq/scaling_min_freq) max=$(cat $C/cpu0/cpufreq/scaling_max_freq) gov=$(cat $C/cpu0/cpufreq/scaling_governor)" >> $LOG

# MTK hotplug: off as before (KEEP_HPS_OFF=1, all cores online); the rm4 thermostat lowers the
# frequency, so hotplug is not needed as a thermal lever. KEEP_HPS_OFF=0 re-enables it.
if [ "$KEEP_HPS_OFF" = "1" ]; then
	echo 0 > /proc/hps/enabled 2>/dev/null
	for o in $C/cpu[1-9]*/online; do echo 1 > "$o" 2>/dev/null; done
else
	echo 1 > /proc/hps/enabled 2>/dev/null
fi

# IO scheduler: eMMC is non-rotational (rotational=0), so cfq's seek-avoidance
# heuristics just add latency. Prefer deadline, fall back to noop, never cfq.
if ! echo deadline > /sys/block/mmcblk0/queue/scheduler 2>/dev/null; then
  echo noop > /sys/block/mmcblk0/queue/scheduler 2>/dev/null
fi
# GPS/AGPS daemons: no GPS use on a kitchen tablet (location is network-only); frees RSS + wakeups
stop slpd 2>/dev/null
stop wifi2agps 2>/dev/null

# VM tuning for eMMC. Android defaults write back dirty pages every 2-3s, which
# turns into a stream of tiny writes on flash (write amplification + I/O stalls).
# This device is always on mains, so batching writes is nearly risk-free.
echo 1000 > /proc/sys/vm/dirty_expire_centisecs 2>/dev/null      # 2s  -> 10s
echo 1500 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null   # 3s  -> 15s
# larger readahead helps sequential media reads (Stremio / TV streams / Spotify cache)
echo 512 > /sys/block/mmcblk0/queue/read_ahead_kb 2>/dev/null
# keep dentry/inode cache longer: file lookups are cheaper than re-reading eMMC
echo 50 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null            # 100 -> 50
