/dts-v1/;

/ {
	model = "MT8167";
	compatible = "mediatek,mt8167";
	interrupt-parent = <0x1>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;

	atf_logger {
		compatible = "mediatek,atf_logger";
		interrupts = <0x0 0xdd 0x1>;
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		linux,phandle = <0x7>;
		phandle = <0x7>;

		opp00 {
			opp-hz = <0x0 0x23a4c180>;
			opp-microvolt = <0x118c30>;
		};

		opp01 {
			opp-hz = <0x0 0x2c8df1e0>;
			opp-microvolt = <0x118c30>;
		};

		opp02 {
			opp-hz = <0x0 0x3dfd2400>;
			opp-microvolt = <0x124f80>;
		};

		opp03 {
			opp-hz = <0x0 0x47498300>;
			opp-microvolt = <0x1312d0>;
		};

		opp04 {
			opp-hz = <0x0 0x4d7c6d00>;
			opp-microvolt = <0x13d620>;
		};
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0>;
			enable-method = "psci";
			cpu-idle-states = <0x2 0x2 0x3 0x3 0x3>;
			clocks = <0x4 0x0 0x5 0x8 0x6 0x0>;
			clock-names = "cpu", "intermediate", "armpll";
			operating-points-v2 = <0x7>;
			clock-frequency = "M|m";
			proc-supply = <0x8>;
			linux,phandle = <0x9>;
			phandle = <0x9>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x1>;
			enable-method = "psci";
			cpu-idle-states = <0x2 0x2 0x3 0x3 0x3>;
			clocks = <0x4 0x0 0x5 0x8 0x6 0x0>;
			clock-names = "cpu", "intermediate", "armpll";
			operating-points-v2 = <0x7>;
			clock-frequency = "M|m";
			proc-supply = <0x8>;
			linux,phandle = <0xa>;
			phandle = <0xa>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x2>;
			enable-method = "psci";
			cpu-idle-states = <0x2 0x2 0x3 0x3 0x3>;
			clocks = <0x4 0x0 0x5 0x8 0x6 0x0>;
			clock-names = "cpu", "intermediate", "armpll";
			operating-points-v2 = <0x7>;
			clock-frequency = "M|m";
			proc-supply = <0x8>;
			linux,phandle = <0xb>;
			phandle = <0xb>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x3>;
			enable-method = "psci";
			cpu-idle-states = <0x2 0x2 0x3 0x3 0x3>;
			clocks = <0x4 0x0 0x5 0x8 0x6 0x0>;
			clock-names = "cpu", "intermediate", "armpll";
			operating-points-v2 = <0x7>;
			clock-frequency = "M|m";
			proc-supply = <0x8>;
			linux,phandle = <0xc>;
			phandle = <0xc>;
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x4b0>;
				linux,phandle = <0x3>;
				phandle = <0x3>;
			};

			cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010000>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x3e8>;
				min-residency-us = <0x7d0>;
				linux,phandle = <0x2>;
				phandle = <0x2>;
			};
		};
	};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		atf-reserved-memory@43000000 {
			compatible = "mediatek,mt8167-atf-reserved-memory";
			no-map;
			reg = <0x0 0x43000000 0x0 0x30000>;
		};

		ram_console-reserved-memory@44400000 {
			compatible = "mediatek,ram_console";
			reg = <0x0 0x44400000 0x0 0x10000>;
		};

		pstore-reserved-memory@44410000 {
			compatible = "mediatek,pstore";
			reg = <0x0 0x44410000 0x0 0xe0000>;
		};

		minirdump-reserved-memory@444f0000 {
			compatible = "mediatek,minirdump";
			reg = <0x0 0x444f0000 0x0 0x10000>;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x0 0x200000>;
			alignment = <0x0 0x200000>;
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x0 0x4 0x8 0x0 0x5 0x8 0x0 0x6 0x8 0x0 0x7 0x8>;
		interrupt-affinity = <0x9 0xa 0xb 0xc>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	clocks {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		compatible = "simple-bus";
		ranges;

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x18cba80>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x0>;
			clock-frequency = <0x7d00>;
			linux,phandle = <0xe>;
			phandle = <0xe>;
		};

		dummy26m {
			compatible = "fixed-clock";
			clock-frequency = <0x18cba80>;
			#clock-cells = <0x0>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0xd>;
		interrupts = <0x1 0xd 0xf08 0x1 0xe 0xf08 0x1 0xb 0xf08 0x1 0xa 0xf08>;
		clock-frequency = <0xc65d40>;
	};

	soc {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		compatible = "simple-bus";
		ranges;

		chipid@08000000 {
			compatible = "mediatek,chipid";
			reg = <0x0 0x8000000 0x0 0x4 0x0 0x8000004 0x0 0x4 0x0 0x8000008 0x0 0x4 0x0 0x800000c 0x0 0x4>;
		};

		topckgen@10000000 {
			compatible = "mediatek,mt8167-topckgen", "syscon";
			reg = <0x0 0x10000000 0x0 0x1000>;
			#clock-cells = <0x1>;
			linux,phandle = <0x5>;
			phandle = <0x5>;
		};

		infracfg@10001000 {
			compatible = "mediatek,mt8167-infracfg", "syscon";
			reg = <0x0 0x10001000 0x0 0x1000>;
			#clock-cells = <0x1>;
			linux,phandle = <0x4>;
			phandle = <0x4>;
		};

		btcvsd@10001000 {
			compatible = "mediatek,audio_bt_cvsd";
			offset = <0xc00 0x2 0xfd0 0xfd4 0xfd8>;
			reg = <0x0 0x10001000 0x0 0x1000 0x0 0x18000000 0x0 0x10000 0x0 0x18080000 0x0 0x8000>;
			interrupts = <0x0 0xc2 0x8>;
		};

		mt_soc_btcvsd_rx_pcm@10001000 {
			compatible = "mediatek,mt_soc_btcvsd_rx_pcm";
		};

		mt_soc_btcvsd_tx_pcm@10001000 {
			compatible = "mediatek,mt_soc_btcvsd_tx_pcm";
		};

		syscfg_pctl_a@10005000 {
			compatible = "mediatek,mt8167-pctl-a-syscfg", "syscon";
			reg = <0x0 0x10005000 0x0 0x1000>;
			linux,phandle = <0xf>;
			phandle = <0xf>;
		};

		toprgu@10007000 {
			compatible = "mediatek,mt8167-wdt", "mediatek,mt6589-wdt";
			reg = <0x0 0x10007000 0x0 0x1000>;
			interrupts = <0x0 0xc6 0x2>;
			#reset-cells = <0x1>;
			linux,phandle = <0x47>;
			phandle = <0x47>;
		};

		timer@10008000 {
			compatible = "mediatek,mt8167-timer", "mediatek,mt6577-timer";
			reg = <0x0 0x10008000 0x0 0x1000>;
			interrupts = <0x0 0x84 0x8>;
			clocks = <0x5 0x32 0xe 0x5 0x5a>;
			clock-names = "clk13m", "clk32k", "bus";
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt8167-pinctrl";
			reg = <0x0 0x1000b000 0x0 0x1000>;
			mediatek,pctl-regmap = <0xf>;
			pins-are-numbered;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
			interrupts = <0x0 0x86 0x4>;
			pinctrl-names = "default";
			pinctrl-0 = <0x10>;
			linux,phandle = <0x12>;
			phandle = <0x12>;

			uart0gpiodefault {
				linux,phandle = <0x17>;
				phandle = <0x17>;
			};

			uart0_rx_set {
				linux,phandle = <0x18>;
				phandle = <0x18>;

				pins_cmd_dat {
					pinmux = <0x3e01>;
				};
			};

			uart0_rx_clear {
				linux,phandle = <0x19>;
				phandle = <0x19>;

				pins_cmd_dat {
					pinmux = <0x3e00>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			uart0_tx_set {
				linux,phandle = <0x1a>;
				phandle = <0x1a>;

				pins_cmd_dat {
					pinmux = <0x3f01>;
				};
			};

			uart0_tx_clear {
				linux,phandle = <0x1b>;
				phandle = <0x1b>;

				pins_cmd_dat {
					pinmux = <0x3f00>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			uart1gpiodefault {
				linux,phandle = <0x1c>;
				phandle = <0x1c>;
			};

			uart1_rx_set {
				linux,phandle = <0x1d>;
				phandle = <0x1d>;

				pins_cmd_dat {
					pinmux = <0x4001>;
				};
			};

			uart1_rx_clear {
				linux,phandle = <0x1e>;
				phandle = <0x1e>;

				pins_cmd_dat {
					pinmux = <0x4000>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			uart1_tx_set {
				linux,phandle = <0x1f>;
				phandle = <0x1f>;

				pins_cmd_dat {
					pinmux = <0x4101>;
				};
			};

			uart1_tx_clear {
				linux,phandle = <0x20>;
				phandle = <0x20>;

				pins_cmd_dat {
					pinmux = <0x4100>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			uart2gpiodefault {
				linux,phandle = <0x21>;
				phandle = <0x21>;
			};

			uart2_rx_set {
				linux,phandle = <0x22>;
				phandle = <0x22>;

				pins_cmd_dat {
					pinmux = <0x2201>;
				};
			};

			uart2_rx_clear {
				linux,phandle = <0x23>;
				phandle = <0x23>;

				pins_cmd_dat {
					pinmux = <0x2200>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			uart2_tx_set {
				linux,phandle = <0x24>;
				phandle = <0x24>;

				pins_cmd_dat {
					pins = <0x2301>;
				};
			};

			uart2_tx_clear {
				linux,phandle = <0x25>;
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x2300>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			pinconf_default {
				linux,phandle = <0x10>;
				phandle = <0x10>;

				pins_cmd_dat {
					pinmux = <0xe03 0xf03 0x1003 0x4406 0x4506 0x4606 0x3701 0x3801 0x3901 0x1103>;
					bias-pull-up;
				};
			};

			audiodefault {
				linux,phandle = <0x5b>;
				phandle = <0x5b>;

				pins_cmd_dat {
					pins = <0x3200>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			audexampon {
				linux,phandle = <0x5c>;
				phandle = <0x5c>;

				pins_cmd_dat {
					pins = <0x3200>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			audexampoff {
				linux,phandle = <0x5d>;
				phandle = <0x5d>;

				pins_cmd_dat {
					pins = <0x3200>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			audi2s1mode0 {
			};

			audi2s1mode1 {
			};

			pmicclkmode0 {
			};

			pmicclkmode1 {
			};

			dspdefault {
				linux,phandle = <0x5e>;
				phandle = <0x5e>;

				pins_cmd_dat {
					pins = <0x4700>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			dsp_pins_rst_high {
				linux,phandle = <0x5f>;
				phandle = <0x5f>;

				pins_cmd_dat {
					pins = <0x4900>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			dsp_pins_rst_low {
				linux,phandle = <0x60>;
				phandle = <0x60>;

				pins_cmd_dat {
					pins = <0x4900>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			dsp_pins_pewr_high {
				linux,phandle = <0x61>;
				phandle = <0x61>;

				pins_cmd_dat {
					pins = <0x1400>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			dsp_pins_pwr_low {
				linux,phandle = <0x62>;
				phandle = <0x62>;

				pins_cmd_dat {
					pins = <0x1400>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			led_pins_pwr_high {
				linux,phandle = <0x63>;
				phandle = <0x63>;

				pins_cmd_dat {
					pins = <0x3300>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			led_pins_pwr_low {
				linux,phandle = <0x64>;
				phandle = <0x64>;

				pins_cmd_dat {
					pins = <0x3300>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			camdefault {
				linux,phandle = <0x3e>;
				phandle = <0x3e>;

				pins_cmd_dat {
					pinmux = <0x6601 0x6701 0x5e01 0x5f01 0x6001 0x6101 0x6201 0x6301>;
				};
			};

			cam0@0 {
				linux,phandle = <0x3f>;
				phandle = <0x3f>;

				pins_cmd_dat {
					pins = <0x3100>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			cam0@1 {
				linux,phandle = <0x40>;
				phandle = <0x40>;

				pins_cmd_dat {
					pins = <0x3100>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			cam0@2 {
				linux,phandle = <0x41>;
				phandle = <0x41>;

				pins_cmd_dat {
					pins = <0x3000>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			cam0@3 {
				linux,phandle = <0x42>;
				phandle = <0x42>;

				pins_cmd_dat {
					pins = <0x3000>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			cam1@0 {
				linux,phandle = <0x43>;
				phandle = <0x43>;

				pins_cmd_dat {
					pins = <0x3100>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			cam1@1 {
				linux,phandle = <0x44>;
				phandle = <0x44>;

				pins_cmd_dat {
					pins = <0x3100>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			cam1@2 {
				linux,phandle = <0x45>;
				phandle = <0x45>;

				pins_cmd_dat {
					pins = <0x2b00>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			cam1@3 {
				linux,phandle = <0x46>;
				phandle = <0x46>;

				pins_cmd_dat {
					pins = <0x2b00>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			cam_pin_mclk {

				pins_cmd_dat {
					pinmux = <0x6601 0x6701 0x5a02 0x5b02 0x5c02 0x5d02 0x5e02 0x5f02 0x6002 0x6102 0x6202 0x6302>;
				};
			};

			cam_pin_pclk {

				pins_cmd_dat {
					pins = <0x6701>;
				};
			};

			cam_pin_gpio90 {

				pins_cmd_dat {
					pins = <0x5a02>;
				};
			};

			cam_pin_gpio91 {

				pins_cmd_dat {
					pins = <0x5b02>;
				};
			};

			cam_pin_gpio92 {

				pins_cmd_dat {
					pins = <0x5c02>;
				};
			};

			cam_pin_gpio93 {

				pins_cmd_dat {
					pins = <0x5d02>;
				};
			};

			cam_pin_gpio94 {

				pins_cmd_dat {
					pins = <0x5e02>;
				};
			};

			cam_pin_gpio95 {

				pins_cmd_dat {
					pins = <0x5f02>;
				};
			};

			cam_pin_gpio96 {

				pins_cmd_dat {
					pins = <0x6002>;
				};
			};

			cam_pin_gpio97 {

				pins_cmd_dat {
					pins = <0x6102>;
				};
			};

			cam_pin_gpio98 {

				pins_cmd_dat {
					pins = <0x6202>;
				};
			};

			cam_pin_gpio99 {

				pins_cmd_dat {
					pins = <0x6302>;
				};
			};

			default {
				linux,phandle = <0x48>;
				phandle = <0x48>;
			};

			eint0default {
				linux,phandle = <0x4f>;
				phandle = <0x4f>;

				pins_cmd_dat {
					pins = <0x6400>;
					slew-rate = <0x0>;
					bias-disable;
				};
			};

			eint@0 {
				linux,phandle = <0x50>;
				phandle = <0x50>;

				pins_cmd_dat {
					pins = <0x6400>;
					slew-rate = <0x0>;
					bias-disable;
				};
			};

			eintoutput0 {
				linux,phandle = <0x51>;
				phandle = <0x51>;

				pins_cmd_dat {
					pins = <0x6400>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			eintoutput1 {
				linux,phandle = <0x52>;
				phandle = <0x52>;

				pins_cmd_dat {
					pins = <0x6400>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			rstoutput0 {
				linux,phandle = <0x53>;
				phandle = <0x53>;

				pins_cmd_dat {
					pins = <0x6500>;
					slew-rate = <0x1>;
					output-low;
				};
			};

			rstoutput1 {
				linux,phandle = <0x54>;
				phandle = <0x54>;

				pins_cmd_dat {
					pins = <0x6500>;
					slew-rate = <0x1>;
					output-high;
				};
			};

			hwen_high {
			};

			hwen_low {
			};

			gpslna@0 {
				linux,phandle = <0x49>;
				phandle = <0x49>;
			};

			gpslna@1 {
				linux,phandle = <0x4a>;
				phandle = <0x4a>;
			};

			gpslna@2 {
				linux,phandle = <0x4b>;
				phandle = <0x4b>;
			};

			hdmi_pins_default {
				linux,phandle = <0x35>;
				phandle = <0x35>;
			};

			hdmi_pins_hpd {
				linux,phandle = <0x36>;
				phandle = <0x36>;
			};

			i2c0@0 {
				linux,phandle = <0x26>;
				phandle = <0x26>;

				pins1 {
					pinmux = <0x3a01 0x3b01>;
					bias-disable;
				};
			};

			i2c1@0 {
				linux,phandle = <0x27>;
				phandle = <0x27>;

				pins1 {
					pinmux = <0x3401 0x3501>;
					bias-disable;
				};
