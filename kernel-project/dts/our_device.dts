		BAT_NOTIFY {
			compatible = "mediatek,bat_notify";
		};

		bat_comm {
			compatible = "mediatek,battery";
			stop_charging_in_takling = <0x1>;
			talking_recharge_voltage = <0xed8>;
			talking_sync_time = <0x3c>;
			mtk_temperature_recharge_support = <0x1>;
			max_charge_temperature = <0x32>;
			max_charge_temperature_minus_x_degree = <0x2f>;
			min_charge_temperature = <0x0>;
			min_charge_temperature_plus_x_degree = <0x6>;
			err_charge_temperature = <0xff>;
			v_pre2cc_thres = <0xd48>;
			v_cc2topoff_thres = <0xfd2>;
			recharging_voltage = <0x100e>;
			charging_full_current = <0x64>;
			config_usb_if = <0x0>;
			usb_charger_current_suspend = <0x0>;
			usb_charger_current_unconfigured = <0x1b58>;
			usb_charger_current_configured = <0xc350>;
			usb_charger_current = <0xc350>;
			ac_charger_current = <0x186a0>;
			non_std_ac_charger_current = <0xc350>;
			charging_host_charger_current = <0xfde8>;
			apple_0_5a_charger_current = <0xc350>;
			apple_1_0a_charger_current = <0xfde8>;
			apple_2_1a_charger_current = <0x13880>;
			bat_low_temp_protect_enable = <0x0>;
			v_charger_enable = <0x0>;
			v_charger_max = <0x1964>;
			v_charger_min = <0x1130>;
			onehundred_percent_tracking_time = <0xa>;
			npercent_tracking_time = <0x14>;
			sync_to_real_tracking_time = <0x3c>;
			v_0percent_tracking = <0xd7a>;
			high_battery_voltage_support = <0x0>;
			interrupt-parent = <0x55>;
			interrupts = <0xa 0x4>;
		};

		dumchar {
			compatible = "mediatek,mt8167-dummy_char";
		};

		extd_drv@0 {
			compatible = "mediatek,extd_dev";
		};

		led_en {
			compatible = "emdoor,ts809_led_en";
		};

		flashlight_core {
			compatible = "mediatek,flashlight_core";
		};

		flashlights_lm3642 {
			compatible = "mediatek,flashlights_lm3642";
		};

		ice_debug {
			compatible = "mediatek,mt8167-ice_debug", "mediatek,mt8173-ice_debug";
			clocks = <0x5 0x4a>;
			clock-names = "ice_dbg";
		};

		isp_pipemgr {
			compatible = "mediatek,mt8167-isp_pipemgr";
		};

		isp_sysram {
			compatible = "mediatek,mt8167-isp_sysram";
		};

		mfgsys-async {
			compatible = "mediatek,mt8167-mfg-async";
			power-domains = <0x30 0x3>;
		};

		mfgsys-2d {
			compatible = "mediatek,mt8167-mfg-2d";
			power-domains = <0x30 0x4>;
		};

		mtee {
			compatible = "mediatek,mtee";
			clocks = <0x5 0x7b 0x5 0x65 0x38 0x5 0x16 0x0 0x38 0x0>;
			clock-names = "GCPU", "TRNG", "IMG_CLK", "SMI_COMMON", "IMG_SMI";
			pm-devs = <0x14 0x37>;
			pm-names = "isp", "disp";
		};

		mtgpufreq {
			compatible = "mediatek,mt8167-gpufreq";
			reg-vgpu-supply = <0x2a>;
		};

		pseudo-m4u {
			compatible = "mediatek,mt8167-pseudo-m4u";
			iommus = <0x56 0x1>;
		};

		pseudo-m4u-larb0 {
			compatible = "mediatek,mt8167-pseudo-port-m4u";
			mediatek,larbid = <0x0>;
			iommus = <0x56 0x0 0x56 0x1 0x56 0x2 0x56 0x3 0x56 0x4 0x56 0x5 0x56 0x5 0x56 0x6 0x56 0x7>;
		};

		pseudo-m4u-larb1 {
			compatible = "mediatek,mt8167-pseudo-port-m4u";
			mediatek,larbid = <0x1>;
			iommus = <0x56 0x8 0x56 0x9 0x56 0xa 0x56 0xb 0x56 0xc 0x56 0xd 0x56 0xe 0x56 0xf 0x56 0x10 0x56 0x11 0x56 0x12 0x56 0x13 0x56 0x14>;
		};

		pseudo-m4u-larb2 {
			compatible = "mediatek,mt8167-pseudo-port-m4u";
			mediatek,larbid = <0x2>;
			iommus = <0x56 0x15 0x56 0x16 0x56 0x17 0x56 0x18 0x56 0x19 0x56 0x1a 0x56 0x1b>;
		};
	};

	lcm {
		compatible = "mediatek,lcm";
	};

	zigbee {
		compatible = "mediatek,cc2530";
	};

	memory@00000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x20000000>;
	};

	chosen {
		bootargs = "console=ttyS0,921600n1 root=/dev/ram initrd=0x44000200,0x200000";
	};

	cust_accel@0 {
		compatible = "mediatek,STK8BAXX";
		i2c_num = <0x1>;
		i2c_addr = <0x18 0x0 0x0 0x0>;
		direction = <0xe>;
		power_id = <0xffff>;
		power_vol = <0x0>;
		firlen = <0x2>;
		is_batch_supported = <0x0>;
	};

	fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
	};

	fixedregulator@1 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
	};

	mtcpufreq {
		compatible = "mediatek,mt8167-cpufreq";
		reg-ext-vproc-supply = <0x57>;
	};

	mt8167_audio_codec {
		compatible = "mediatek,mt8167-codec";
		clocks = <0x5 0x5b>;
		clock-names = "bus";
		mediatek,afe-regmap = <0x58>;
		mediatek,apmixedsys-regmap = <0x6>;
		mediatek,pwrap-regmap = <0x11>;
		mediatek,speaker-mode = <0x0>;
		mediatek,dmic-wire-mode = <0x1>;
		mediatek,headphone-cap-sel = <0x1>;
	};

	panel@0 {
		compatible = "kd,kd070d5450nha6";
		pinctrl-names = "default";
		pinctrl-0 = <0x59>;
		gpio_lcd_pwr = <0x12 0x2f 0x0>;
		gpio_lcd_rst = <0x12 0x42 0x0>;
		reg-lcm-supply = <0x5a>;
		status = "okay";
	};

	sound {
		compatible = "mediatek,mt8167-mt6392";
		mediatek,platform = <0x58>;
		mediatek,hp-spk-amp-warmup-time-us = <0x9c40>;
		mediatek,hp-spk-amp-shutdown-time-us = <0x9c40>;
		mediatek,ext-spk-amp-warmup-time-us = <0x13880>;
		mediatek,ext-spk-amp-shutdown-time-us = <0x9c40>;
		pinctrl-names = "default", "extamp_on", "extamp_off";
		pinctrl-0 = <0x5b>;
		pinctrl-1 = <0x5c>;
		pinctrl-2 = <0x5d>;
		status = "okay";
	};

	vibrator@0 {
		compatible = "mediatek,vibrator";
		vib_timer = <0x19>;
		vib_limit = <0x9>;
		vib_vol = <0x5>;
	};

	synaptics {
		compatible = "emdoor,synaptics_dsp";
		interrupt-parent = <0x12>;
		interrupts = <0x48 0x2>;
		pinctrl-names = "default", "dsp_rst_high", "dsp_rst_low", "dsp_pwr_high", "dsp_pwr_low", "led_pwr_high", "led_pwr_low";
		pinctrl-0 = <0x5e>;
		pinctrl-1 = <0x5f>;
		pinctrl-2 = <0x60>;
		pinctrl-3 = <0x61>;
		pinctrl-4 = <0x62>;
		pinctrl-5 = <0x63>;
		pinctrl-6 = <0x64>;
	};
};
