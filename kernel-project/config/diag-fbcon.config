# Diagnostic config fragment: put the kernel console on the panel.
#
# Why this exists: this device has no exposed UART, its USB port is wired as a host port,
# and recovery has no adb -- so a kernel that fails to reach usable userspace leaves no way
# to see what happened except /proc/last_kmsg read after the NEXT boot. That is slow, and
# the 64K RAM console wraps.
#
# The panel itself is the way out. The stock cmdline already contains `console=tty0`, but
# the vendor config has `# CONFIG_VT is not set`, so tty0 goes nowhere and CONFIG_LOGO
# (which IS set) never draws, because fb_show_logo() is driven by fbcon. Turning VT and
# fbcon on gives two things at once:
#
#   1. The Tux logo at framebuffer registration -- a userspace-free proof that the whole
#      display path (panel power, DPI timings, format, DISP pipeline) actually works.
#   2. Kernel messages printed live on the screen, readable with a phone camera.
#
# That is how we established the display path is fine and that something *later* in boot
# turns a working display green.
#
# Apply on top of maic_defconfig, e.g.:
#   scripts/kconfig/merge_config.sh -m .config config/diag-fbcon.config
# or set these in an existing .config and run `make olddefconfig`.
#
# NOT part of maic_defconfig: Android expects VT off, and fbcon owning fb0 can fight
# SurfaceFlinger. This is for diagnostic builds.
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_LOGO and CONFIG_LOGO_LINUX_CLUT224 are already set by the vendor defconfig.

# Denser font: on this 1024x600 panel 8x16 gives 128x37 characters, 6x10 gives 170x60.
# MTK prefixes every line with ~31 columns of "[    1.234567]  (2)[1:swapper/0]", so the
# extra width matters. Both are compiled in; fbcon picks one, and `fbcon=font:6x10` on the
# cmdline forces it -- but the cmdline budget is only 99 bytes before MTK's LK truncates,
# so weigh it against the boot flags. pstore captures the full log either way, so the
# on-screen text is a bonus channel, not the primary one.
CONFIG_FONT_6x10=y
