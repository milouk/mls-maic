CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y          # Xbox (and clone) pads
CONFIG_HID_SONY=y               # DualShock 3/4 (NEW_LEDS/LEDS_CLASS already =y)

# --- Diagnostics ---
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y   # dmesg logs VID/PID/product/manufacturer on every plug

# --- Explicitly off ---
# CONFIG_USB_OTG is not set
# CONFIG_USB_OTG_WHITELIST is not set
# CONFIG_MTK_MUSB_SW_WITCH_MODE is not set

# MAIC filesystems/compression fragment (docs/research/filesystems-compression.md).
# All built-in: CONFIG_MODULES is off on this kernel.

# zram with LZ4 (zram's own backend on 4.4; no crypto API needed)
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y

# NTFS: read-only in kernel. Write access, if ever wanted, is ntfs-3g (FUSE).
CONFIG_NTFS_FS=y
# CONFIG_NTFS_DEBUG is not set
# CONFIG_NTFS_RW is not set

# overlayfs (Docker overlay2, Magisk-style overlays)
CONFIG_OVERLAY_FS=y

# squashfs with LZ4 and XZ (plus zlib/lzo, cheap)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y

# SMB/CIFS client. 4.4 cannot build CIFS without SMB1; use vers=2.1/3.0 when
# mounting. Weak LANMAN/plaintext password hashing stays off.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_CIFS=y
CONFIG_CIFS_SMB2=y
CONFIG_CIFS_XATTR=y
# CONFIG_CIFS_POSIX is not set
# CONFIG_CIFS_FSCACHE is not set
# CONFIG_CIFS_WEAK_PW_HASH is not set
# CONFIG_CIFS_UPCALL is not set
# CONFIG_CIFS_DFS_UPCALL is not set
# CONFIG_CIFS_STATS is not set
# CONFIG_CIFS_DEBUG is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_NCP_FS is not set
# CONFIG_CODA_FS is not set
# CONFIG_AFS_FS is not set

# F2FS: for mounting external media only. Do NOT convert /data (wipes the rescue image).
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# exFAT (fs/exfat, vendored from namjaejeon/linux-exfat-oot 68072a2d)
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"

# --- Docker / containers (kernel-project/patches/docker, source docs/research/docker.md) ---
# All built-in: CONFIG_MODULES is off on this kernel.
#
# Namespaces (USER_NS deliberately off: widens attack surface on 4.4.22, only needed
# for userns-remap/rootless).
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# CONFIG_USER_NS is not set
#
# IPC: runc's default spec mounts mqueue on /dev/mqueue (container start fails without
# it); SysV shm is used by postgres & co. Bionic never uses SysV, no Android impact.
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
#
# cgroup v1 controllers
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
# CPUSETS activates Android init.rc's placeholder "cpus 0" groups -> needs
# magisk/post-fs-data.d/10-maic-cpuset.sh on first boot (see README).
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
# swap accounting only when booted with swapaccount=1 (no cmdline budget spent now)
# CONFIG_MEMCG_SWAP_ENABLED is not set
CONFIG_MEMCG_KMEM=y
CONFIG_CFS_BANDWIDTH=y
#
# pre-4.7: runc mounts /dev/pts with newinstance
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
#
# Storage: overlay2 driver, ACL/xattr expected by many images
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
#
# Networking (Phase 2 bridge networking; harmless in Phase 1 host networking).
# VETH requires the xt_qtaguid patch in docker.patch.
CONFIG_VETH=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NF_NAT_IPV6=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
#
# Kept on on purpose (Android INTERNET-permission model); container non-root users
# need GID 3003 (aid_inet). See README.
CONFIG_ANDROID_PARANOID_NETWORK=y
