# MAIC: MUST stay 0x10000, identical to stock. pstore zone ADDRESSES are derived
# from the sizes (cprz sits at phys_addr + dump_mem_sz), so a kernel that computes a
# different layout writes its console where the next kernel will not look. Raising
# this to 0x80000 was tried: our kernel put the console at 0x4445F000 while stock
# reads 0x444BF000, and the log from that boot was unrecoverable (there is no
# /dev/mem on this device to read it back manually). Bigger and unreadable is
# strictly worse than small and readable.
CONFIG_PSTORE_CONSOLE_SIZE=0x10000
# pstore (mtk_ram_console.c only registers its own console #ifndef CONFIG_PSTORE), and 64K
# wrapped away the whole early boot every time. fs/pstore/ram.c:669 charges console_size
# TWICE (cprz + bprz), so against the 896K already reserved at 0x44410000 this is the
# largest safe value: it still leaves 79 crash-dump records. 0x80000 would underflow
# dump_mem_sz and the ramoops probe would fail, leaving no pstore at all.
CONFIG_PSTORE_PMSG_SIZE=0x10000
CONFIG_PSTORE_MEM_ADDR=0x44410000
CONFIG_PSTORE_MEM_SIZE=0xe0000
